includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    # The PHP versions the package supports, not the one PHPStan happens to run
    # on. Left unset, the range is the runtime's — 8.4 in the development image
    # — and a native-typed class constant, which is a parse error on 8.2, passes
    # analysis without a word; only the 8.2 CI leg would find it. `min` is the
    # floor in composer.json and `max` the newest version the CI matrix runs;
    # `VersioningTest` fails if either drifts.
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - src
        - tests
        - workbench
    tmpDir: build/phpstan
    ignoreErrors:
        # The other half of the suppression documented on
        # AuraQuery::likeExpression(). Laravel 13 declares `Expression` generic
        # and types its constructor with the template, Laravel 12 does not — so
        # this error exists on one of the two framework majors this package
        # supports and not on the other, and an inline ignore that matches
        # nothing is itself a (non-ignorable) error. Hence `reportUnmatched`.
        -
            identifier: argument.type
            path: src/Query/AuraQuery.php
            reportUnmatched: false
