{
    "name": "tamas-labs/laravel-aura",
    "description": "Laravel package that builds the JSON contract consumed by the Aura Vue data table.",
    "keywords": [
        "laravel",
        "aura",
        "datatable",
        "json-schema"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/tamas-labs/laravel-aura",
    "authors": [
        {
            "name": "Tamas Labs",
            "email": "tbalint78@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tamas-labs/laravel-aura/issues",
        "source": "https://github.com/tamas-labs/laravel-aura"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/log": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "opis/json-schema": "^2.3",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "tamas-labs/aura-schema": "^1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tamas-labs/aura-schema"
        }
    ],
    "suggest": {
        "tamas-labs/aura-schema": "Validate generated payloads against the Aura wire contract at runtime during development."
    },
    "autoload": {
        "psr-4": {
            "TamasLabs\\Aura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TamasLabs\\Aura\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TamasLabs\\Aura\\AuraServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "quality": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "quality:coverage": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ],
        "bc-check": [
            "mkdir -p build/bc-check",
            "@composer --working-dir=build/bc-check --no-interaction --no-progress require roave/backward-compatibility-check:^8.21",
            "build/bc-check/vendor/bin/roave-backward-compatibility-check"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve --ansi --host=0.0.0.0 --port=8000"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
